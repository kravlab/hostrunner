// Minimal devcontainer wired to hostrunner. Copy the initializeCommand,
// mounts and remoteEnv entries into your own devcontainer.json; the image is
// only an example. Requires `mise run install` on the host (hostrunner in PATH).
{
  "name": "hostrunner example",
  "image": "docker.io/library/alpine:3",

  // Starts the host daemon for this container, or arms the running one
  // (e.g. across a rebuild), and installs the hostrun client into the
  // runtime directory mounted below. The array form runs without a shell,
  // so paths with spaces stay intact.
  "initializeCommand": [
    "hostrunner", "up",
    "--dir", "${localEnv:XDG_RUNTIME_DIR}/hostrunner/${devcontainerId}",
    "--workspace", "${localWorkspaceFolder}",
    "--container-workspace", "${containerWorkspaceFolder}"
  ],

  "mounts": [
    // The daemon's socket and the hostrun client. Read-only: connecting to a
    // socket needs no write access, and the container must not be able to
    // tamper with the daemon's files.
    "source=${localEnv:XDG_RUNTIME_DIR}/hostrunner/${devcontainerId},target=/run/hostrunner,type=bind,readonly",
    // .devcontainer (with the rules) stays read-only inside the container.
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly"
  ],

  // Makes `hostrun` available as a command.
  "remoteEnv": { "PATH": "${containerEnv:PATH}:/run/hostrunner" }
}
